PORT=4000

# Any OpenAI-compatible chat-completions endpoint works. This example uses Groq.
# When the key is missing, roadmap generation uses a grounded deterministic plan
# and chat returns an honest unavailable state.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Partner access is now real accounts, not a shared token. Create the first one:
#   npm run partner -- you@example.org "Your Name" "Your Organisation"
# The password is printed once. Every approval is recorded against that email.

# Production database (hosted libSQL / Turso). Required when NODE_ENV=production:
# most hosts wipe the filesystem on deploy, so a file-backed database loses
# every plan and submission silently.
#   turso db create foster-connect
#   turso db show foster-connect --url
#   turso db tokens create foster-connect
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: override where server.ts looks for the SQLite file.
# Defaults to ../../data/foster_connect.db relative to src/.
# DB_PATH=../../data/foster_connect.db

# Signs the chat history so a browser cannot forge what Maya previously said.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it a random key is generated per process: safe, but in-flight
# conversations lose their history on every restart or deploy.
CHAT_SIGNING_SECRET=

# Email through Resend (https://resend.com). Optional: without a key, password
# resets are issued by a reviewer from /partners/accounts and nothing is sent.
RESEND_API_KEY=
MAIL_FROM=Foster Guide <noreply@fosterguide.org>
SITE_URL=https://fosterguide.org
# Where "new partner account" notices go.
NOTIFY_EMAIL=
