{
  "name": "foster-connect-backend",
  "version": "1.0.0",
  "description": "Backend API for Foster Connect",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/services/*.test.js",
    "partner": "tsx scripts/create-partner.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.25",
    "nodemon": "^3.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.9.0"
  }
}
